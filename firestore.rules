rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCompanyAdminOf(companyId) {
      return profile().role == 'COMPANY' && profile().companyId == companyId;
    }

    function isValidWorkplace(workplace) {
      return workplace.keys().hasOnly(['latitude', 'longitude', 'radiusMeters'])
        && workplace.latitude is number && workplace.latitude >= -90 && workplace.latitude <= 90
        && workplace.longitude is number && workplace.longitude >= -180 && workplace.longitude <= 180
        && workplace.radiusMeters is int && workplace.radiusMeters >= 50 && workplace.radiusMeters <= 1000;
    }

    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isCompanyAdminOf(resource.data.companyId));

      // Employees join an existing company; company accounts must own the company created in the same batch.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'companyId', 'createdAt'])
        && (
          (request.resource.data.role == 'EMPLOYEE'
            && exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)))
          || (request.resource.data.role == 'COMPANY'
            && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerId == uid)
        );

      allow update, delete: if false;
    }

    match /companies/{companyId} {
      allow read: if signedIn() && profile().companyId == companyId;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'inviteCode', 'createdAt']);

      // The owner may only change the workplace; name, owner and invite code are immutable.
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workplace'])
        && isValidWorkplace(request.resource.data.workplace);

      allow delete: if false;
    }

    // Lookup only: anyone may check a single code before signing up, but codes cannot be listed.
    match /inviteCodes/{code} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.inviteCode == code;

      allow update, delete: if false;
    }
  }
}
